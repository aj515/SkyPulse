# --- Production (Vercel) ---
# Set this in Vercel Dashboard > Settings > Environment Variables.
# No VITE_ prefix means it is NOT bundled into client JS — key stays server-side.
OWM_API_KEY=your_openweathermap_api_key_here

# --- Local development (npm run dev) ---
# Vite rewrites /api/owm requests directly to OWM using this key during dev.
# This IS bundled in the dev build but never reaches production.
VITE_OWM_API_KEY=your_openweathermap_api_key_here
